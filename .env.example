# Copy to .env (never commit .env). Shared privately by Role 2.

# --- Nemotron: the ONE switch between Brev, hosted, and offline mock ---
NEMOTRON_PROVIDER=brev            # brev | hosted | mock
BREV_BASE_URL=http://<brev-host>:5000/v1
BREV_MODEL=nemotron
HOSTED_BASE_URL=https://integrate.api.nvidia.com/v1
HOSTED_API_KEY=
HOSTED_MODEL=nvidia/nemotron-3-nano-30b-a3b
MODEL_TIMEOUT_MS=20000
NEMOTRON_THINKING=0               # recommended: a full investigation takes ~6 s instead of ~40 s (1 = reasoning on)

# --- Spacetime (module in spacetime/; Maincloud db ghost-tower-94144) ---
# Local fallback: SPACETIME_HOST=http://127.0.0.1:3010 SPACETIME_DB=ghost-tower
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=ghost-tower-94144
SPACETIME_TOKEN=
SPACETIME_POLL_MS=1000

# --- Twilio (upgraded account; texts ONLY go to these verified team phones) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFIED_NUMBERS=+1XXXXXXXXXX,+1XXXXXXXXXX,+1XXXXXXXXXX
TWILIO_MIN_INTERVAL_S=60          # replans won't re-text the team more often than this
# TWILIO_DRY_RUN=1                # force dry run even with creds

# --- Simulated phone population for warning recipient counts (match the sim scenario) ---
SIM_PHONES=300
SIM_PHONES_BBOX=32.97,-96.78,33.00,-96.73
SIM_SEED=demo-01
DEMO_AREA_NAME=Campbell Rd, Richardson

# --- Classifier endpoint (POST /score) ---
SCORE_URL=http://<brev-host>:8001/score
