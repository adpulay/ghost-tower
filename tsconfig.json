{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "spacetime/src",
    "spacetime/test",
    "spacetime/bindings",
    "sim/src",
    "sim/test",
    "eval/src",
    "eval/test",
    "web/src/patrol/patrolModel.ts",
    "web/src/patrol/patrolModel.test.ts",
    "web/src/spacetime/liveCore.ts",
    "web/src/spacetime/metrics.ts",
    "web/src/spacetime/metrics.test.ts",
    "web/src/spacetime/liveCore.test.ts",
    "web/src/spacetime/types.ts",
    "web/src/spacetime/focusTrack.ts",
    "web/src/spacetime/focusTrack.test.ts",
    "web/src/spacetime/geo.ts",
    "web/src/spacetime/geo.test.ts"
  ],
  // Imports agent/ code (TypeScript parameter properties), so it runs under tsx (npm run eval:routes) instead.
  "exclude": ["eval/src/route_accuracy.ts"]
}
